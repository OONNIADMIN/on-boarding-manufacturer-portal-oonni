# Copy to .env in this folder, then: docker compose up -d --build

# --- App ---
NODE_ENV=production
APP_PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.example
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440
INVITATION_TOKEN_EXPIRE_HOURS=72

# First boot creates this admin if it does not exist. Later starts do not reset the password.
INITIAL_ADMIN_EMAIL=admin@oonni.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=Admin
SEED_ON_START=true

# --- PostgreSQL (Compose service `db`) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_PASSWORD_ENCODED=replace-with-a-strong-db-password
POSTGRES_DB=oonni_onboarding
POSTGRES_PORT=5433

# Used by the app container. Host must be `db` (the Compose service name).
# If POSTGRES_PASSWORD has @ : / # ?, set POSTGRES_PASSWORD_ENCODED to the URL-encoded value.
DATABASE_URL=postgresql://postgres:replace-with-a-strong-db-password@db:5432/oonni_onboarding

# --- Traide / Nautical ---
NAUTICAL_API_URL=https://your-traide-graphql-endpoint
NAUTICAL_BEARER_TOKEN=
NAUTICAL_KEY_BEARER=

# --- ImageKit ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
IMAGEKIT_TEMPLATES_FOLDER=/Template-excel-oonni

# --- Email (Brevo) ---
BREVO_API_KEY=
SMTP_FROM_EMAIL=noreply@oonni.com
SMTP_FROM_NAME=OONNI Platform
