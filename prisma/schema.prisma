generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz

  users User[]

  @@map("roles")
}

model Manufacturer {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  slug       String    @unique @db.VarChar(100)
  thumbnail  String?   @db.VarChar(500)
  /// Optional ImageKit Media Library root path. If null, uploads use /{slug} from this row (legacy: set to /{id}_{slug} if files already live there).
  imagekit_media_root String? @db.VarChar(255)
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  /// Nautical GraphQL seller id (e.g. base64 "Seller:1")
  nautical_seller_id String? @db.VarChar(255)

  users              User[]
  catalogs           Catalog[]
  images             Image[]
  products           Product[]
  inventory_products InventoryProduct[]

  @@map("manufacturers")
}

model User {
  id                          Int       @id @default(autoincrement())
  email                       String    @unique @db.VarChar(255)
  name                        String    @db.VarChar(255)
  password_hash               String?   @db.VarChar(255)
  role_id                     Int
  manufacturer_id             Int?
  is_active                   Int       @default(1)
  invitation_token            String?   @unique @db.VarChar(255)
  invitation_token_expires_at DateTime? @db.Timestamptz
  password_set_at             DateTime? @db.Timestamptz
  created_at                  DateTime  @default(now()) @db.Timestamptz
  updated_at                  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at                  DateTime? @db.Timestamptz

  role         Role          @relation(fields: [role_id], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturer_id], references: [id])
  images       Image[]

  @@map("users")
}

model Catalog {
  id              Int       @id @default(autoincrement())
  manufacturer_id Int
  name            String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(100)
  header_row_index Int      @default(0)
  description      String?
  catalog_file    String?   @db.VarChar(500)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz

  manufacturer Manufacturer @relation(fields: [manufacturer_id], references: [id], onDelete: Cascade)
  products     Product[]

  @@map("catalogs")
}

model Image {
  id                Int       @id @default(autoincrement())
  manufacturer_id   Int
  user_id           Int
  product_id        Int?
  original_filename String    @db.VarChar(255)
  s3_key            String    @unique @db.VarChar(500)
  s3_url            String    @db.VarChar(500)
  imagekit_file_id  String?   @db.VarChar(100)
  file_size         BigInt
  mime_type         String    @db.VarChar(100)
  width             Int?
  height            Int?
  optimized         Int       @default(1)
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at        DateTime? @db.Timestamptz

  manufacturer Manufacturer @relation(fields: [manufacturer_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@map("images")
}

model Product {
  id              Int       @id @default(autoincrement())
  sku             String    @db.VarChar(100)
  manufacturer_id Int
  catalog_id      Int?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz

  manufacturer Manufacturer @relation(fields: [manufacturer_id], references: [id], onDelete: Cascade)
  catalog      Catalog?     @relation(fields: [catalog_id], references: [id], onDelete: SetNull)
  images       Image[]

  @@map("products")
}

/// Marketplace (Nautical) inventory product. Attributes/category/images stay JSON so the shape can change with GraphQL.
model InventoryProduct {
  id                     Int       @id @default(autoincrement())
  manufacturer_id        Int
  nautical_id            String    @db.VarChar(255)
  slug                   String    @db.VarChar(255)
  name                   String    @db.VarChar(500)
  description            String?   @db.Text
  description_html       String?   @db.Text
  currency               String?   @db.VarChar(20)
  seo_title              String?   @db.VarChar(500)
  seo_description        String?   @db.Text
  external_id            String?   @db.VarChar(255)
  is_digital             Boolean   @default(false)
  is_shipping_required   Boolean   @default(true)
  is_bundle              Boolean   @default(false)
  allow_seller_variants  Boolean   @default(false)
  available_for_purchase Boolean   @default(true)
  status                 String?   @db.VarChar(80)
  is_published           Boolean   @default(false)
  has_warnings           Boolean   @default(false)
  has_variant_options    Boolean   @default(false)
  images                 Json      @default("[]")
  dimensions             Json?
  warnings               Json?
  category               Json?
  product_type           Json?
  attributes             Json      @default("[]")
  payload                Json?
  synced_at              DateTime  @db.Timestamptz
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at             DateTime? @db.Timestamptz

  manufacturer Manufacturer       @relation(fields: [manufacturer_id], references: [id], onDelete: Cascade)
  variants     InventoryVariant[]

  @@unique([manufacturer_id, nautical_id])
  @@index([manufacturer_id, deleted_at])
  @@map("inventory_products")
}

/// One product has N variants. Variant attributes are JSON for dynamic marketplace fields.
model InventoryVariant {
  id                   Int      @id @default(autoincrement())
  inventory_product_id Int
  nautical_id          String   @db.VarChar(255)
  name                 String   @db.VarChar(500)
  sku                  String?  @db.VarChar(255)
  seo_description      String?  @db.Text
  images               Json     @default("[]")
  dimensions           Json?
  attributes           Json     @default("[]")
  payload              Json?
  created_at           DateTime @default(now()) @db.Timestamptz
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz

  product InventoryProduct @relation(fields: [inventory_product_id], references: [id], onDelete: Cascade)

  @@unique([inventory_product_id, nautical_id])
  @@index([inventory_product_id])
  @@map("inventory_variants")
}

model CatalogColumnRule {
  id         Int      @id @default(autoincrement())
  label      String   @db.VarChar(120)
  candidates Json
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("catalog_column_rules")
}

/// Traide/Nautical category tree. parent_id is a self-relation so children nest under their parent.
model TraideCategory {
  id                 Int       @id @default(autoincrement())
  nautical_id        String    @unique @db.VarChar(255)
  parent_id          Int?
  parent_nautical_id String?   @db.VarChar(255)
  name               String    @db.VarChar(500)
  slug               String    @db.VarChar(255)
  metadata           Json?
  custom_fields      Json?
  payload            Json?
  synced_at          DateTime  @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at         DateTime? @db.Timestamptz

  parent   TraideCategory?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children TraideCategory[] @relation("CategoryTree")

  @@index([parent_id])
  @@index([slug])
  @@index([deleted_at])
  @@map("traide_categories")
}
